{
  "name": "a-fit",
  "main": "expo-router/entry",
  "version": "2.0.0",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/ui": "~57.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "expo": "~57.0.21",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.24",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.5.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.1.9",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:structure": "node scripts/check-structure.mjs",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run check:structure && npm run format:check && npm test",
    "build:dev": "eas build --platform all --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:prod": "eas build --platform all --profile production",
    "version": "node scripts/sync-version.mjs && git add app.json"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      ".impeccable"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@kingstinct/.*|react-native-health-connect|react-native-nitro-modules))"
    ]
  }
}
