{
  "expo": {
    "name": "A-FIT",
    "slug": "a-fit",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/A-FIT.png",
    "scheme": "afit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.abosufyan.afit",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["ar", "en"],
        "CFBundleDevelopmentRegion": "ar"
      }
    },
    "android": {
      "package": "com.abosufyan.afit",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#0E1B2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B1420"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "A-FIT reads your step count so your daily progress and group leaderboard reflect your real steps. أي-فت يقرأ عدد خطواتك لعرض تقدمك اليومي وترتيبك في المجموعة.",
          "background": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A-FIT uses the camera only to scan a product's barcode so you can log it. أي-فت يستخدم الكاميرا فقط لمسح باركود المنتج لتسجيله.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef1949a0-753f-4324-af02-5f9bc0307576"
      }
    },
    "owner": "abosufyan",
    "updates": {
      "url": "https://u.expo.dev/ef1949a0-753f-4324-af02-5f9bc0307576",
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
